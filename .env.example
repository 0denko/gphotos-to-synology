# =============================================================================
# Google Photos -> Synology DSM Background Migrator Configuration
# =============================================================================

# Synology DSM user/group IDs (run `id` via SSH on your NAS to check)
PUID=1026
PGID=100
TZ=UTC

# Web Dashboard port on the NAS
APP_PORT=8765

# Storage paths inside container (mapped via docker-compose.yml volumes)
DATA_DIR=/data/config
WORK_DIR=/data/work
INBOX_DIR=/data/inbox
PHOTOS_DIR=/data/photos

# Polling & scheduling
POLL_INTERVAL_MINUTES=60
MIN_FREE_DISK_GB=5.0
INBOX_STABILITY_SECONDS=15

# Folder organization under PHOTOS_DIR:
#   "year_month"  -> 2024/07/IMG_1234.JPG (recommended for Synology Photos)
#   "year_ym"     -> 2024/2024-07/IMG_1234.JPG
#   "album"       -> Albums/<AlbumName>/IMG_1234.JPG (or 2024/07 if not in album)
FOLDER_TEMPLATE=year_month

# Archive handling after verified ingestion:
#   Inbox:  "move_to_processed" | "delete" | "keep"
#   Drive:  "keep" | "trash"  (requires full drive scope if "trash")
INBOX_POST_ACTION=move_to_processed
GDRIVE_POST_ACTION=keep
GDRIVE_FOLDER_NAME=Takeout
GDRIVE_ARCHIVE_PREFIX=takeout-

# Metadata repair & existing NAS library deduplication
WRITE_EXIF_METADATA=true
WRITE_ALBUM_TAGS=true
AUTO_INDEX_EXISTING_PHOTOS=true
# Deduplication mode:
#   "strict_hash"      -> Exact file SHA-256 only
#   "exact_and_pixels" -> Exact SHA-256 + decoded pixel SHA-256 (catches EXIF/header changes)
#   "perceptual"       -> Exact + pixel + 128-bit visual dHash+vHash (matches resized/re-compressed copies)
DEDUP_MODE=perceptual
PERCEPTUAL_MAX_DISTANCE=10
# When a visual duplicate has higher resolution or clarity than the existing NAS copy:
#   "auto_upgrade_quarantine" -> Upgrade NAS copy & safely quarantine replaced file under /data/work/replaced_duplicates
#   "keep_existing"           -> Never replace existing NAS photos
DUPLICATE_QUALITY_POLICY=auto_upgrade_quarantine

# Optional: Synology DSM 7 Photos API (for native virtual album sync)
SYNOLOGY_API_ENABLED=false
SYNOLOGY_URL=http://host.docker.internal:5000
SYNOLOGY_USERNAME=
SYNOLOGY_PASSWORD=
SYNOLOGY_SPACE=personal
SYNOLOGY_VERIFY_SSL=false
SYNOLOGY_ALBUM_SYNC_RETRY_MINUTES=15

# Optional: Notifications (Webhook: ntfy, Discord, Slack, or generic JSON POST)
WEBHOOK_URL=
WEBHOOK_TYPE=generic

# Optional: SMTP email notifications
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=
SMTP_USE_TLS=true

# Takeout annual schedule reminder (days after first scheduled archive)
TAKEOUT_RENEWAL_REMINDER_DAYS=335
